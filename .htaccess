# ==============================================================================
# Hostinger Production .htaccess Configuration
# Optimized for: Vite React SPA + Node.js Backend + LiteSpeed / Apache 2.4+
# AAAN Cart - High Performance E-Commerce Store
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY HEADERS & DIRECTORY PROTECTION
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent clickjacking attacks
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Cross-site scripting (XSS) filter protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer policy for privacy and analytics integrity
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions policy (Disable unwanted browser sensors)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
    
    # Enable HTTP Strict Transport Security (HSTS) - 1 Year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Disable directory browsing / file indexing
Options -Indexes

# Block access to hidden files (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to sensitive source or config files
<FilesMatch "(^#.*#|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env)|~)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. FORCE HTTPS & CANONICAL DOMAIN REWRITE
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Enforce HTTPS on Hostinger
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.*)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# 3. HIGH SPEED COMPRESSION (GZIP / DEFLATE / BROTLI)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML and fonts
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ------------------------------------------------------------------------------
# 4. BROWSER CACHING (LEVERAGE EXPIRES HEADERS)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML (Never cache entry HTML so updates deploy instantly)
    ExpiresByType text/html "access plus 0 seconds"

    # Data / JSON
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"

    # CSS & JavaScript (Vite chunk hashes make 1 year safe)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Web Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # Media / Images
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cache static assets with immutable flag
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|gif|svg|woff|woff2|ttf|otf|eot|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # Disable caching for HTML and dynamic service-worker
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 5. SPA ROUTING (REACT ROUTER CLIENT-SIDE FALLBACK)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Do not rewrite actual physical files, directories, or symlinks
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Pass all remaining page requests to index.html for React SPA routing
    RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 6. UTF-8 ENCODING
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8
